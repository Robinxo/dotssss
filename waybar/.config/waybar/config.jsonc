{
  "layer": "top",
  "position": "top",
  "exclusive": true,
  "modules-left": ["hyprland/workspaces", "hyprland/window"],
  "modules-center": ["custom/potato"],
  "modules-right": [
    "network#speed",
    "clock",
    "pulseaudio",
    "memory",
    "cpu",
    "tray",
  ],

  "tray-position": "right",
  "custom/potato": {
    "exec": "potd -fN ",
    "on-click": "potctl -t",
    "on-click-right": "potctl -r",
  },
  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "1": " ",
      "2": " ",
      "3": " 󰺕 ",
      "4": "  ",
      "5": "  ",
      "6": " 󰉋 ", // Folder
      "7": " 󰭹 ", // Chat
      "8": " 󰈙 ", // Document
      "9": " 󰆼 ", // Cloud / Sync
      "10": " 󰒓 ", // Tools
      "urgent": "",
      "focused": "",
      "default": "",
    },
    "persistent-workspaces": {
      "*": 5, // 5 workspaces by default on every m
    },
    "all-outputs": true,
    "disable-scroll": true,
    "on-click": "hyprctl dispatch workspace {name}",
  },

  "clock": {
    "tooltip-format": "<big>[{:%Y %B}]</big>\n<tt><small>{calendar}</small></tt>",
    "format": "[{:%I:%M %p}]",
    "format-alt": "[{:%Y-%m-%d}]",
  },

  "pulseaudio": {
    "format": "[VOL:{volume}%]",
    "format-muted": "Muted",
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +5%",
    "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -5%",
    "scroll-step": 5,
  },

  "cpu": {
    "format": "[C {usage}%]",
  },

  "memory": {
    "format": "[R {used}/{total}MiB]",
  },

  "network": {
    "format-wifi": "{essid} {signal}%",
    "format-ethernet": "ETH {ifname}: {ipaddr}",
    "format-disconnected": "NO NET",
  },
  "network#speed": {
    "interval": 1,
    "format": "{ifname}",
    "format-wifi": "[ {bandwidthDownBytes}  {bandwidthUpBytes}] ",
    "format-ethernet": "{icon} {bandwidthDownBytes}  {bandwidthUpBytes} ",
    "format-disconnected": "󰌙",
    "tooltip-format": "{ipaddr}",
    "format-linked": "󰈁 {ifname} (No IP)",
    "tooltip-format-wifi": "{essid} {icon} {signalStrength}%",
    "tooltip-format-ethernet": "{ifname} 󰌘",
    "tooltip-format-disconnected": "󰌙 Disconnected",
    "max-length": 30,
  },
  "hyprland/window": {
    "format": "[] = {}",
    "tooltip": false,
    "on-click": "swaync-client -t",
  },
  // },

  "tray": {
    "icon-size": 15,
    "spacing": 1,
  },

  "module-margin": 6,
  "reload_style_on_change": true,
}
